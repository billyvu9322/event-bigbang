  "casts": [
    {
      "id": "cst-019f936ddc247bc1a8ffb968f2721157",
      "event_id": "evt-06fp6li727o78",
      "name": "BIGBANG",
      "role": "\u003Cp align=\"justify\"\u003E   \u003Cb\u003EBIGBANG\u003C/b\u003E là nhóm nhạc nam được \u003Cb\u003EYG Ent\u003C/b\u003E ra mắt vào năm 2006. Kể từ đĩa đơn đầu tay \"Bigbang\", nhóm đã phát triển thành một trong những nghệ sĩ hàng đầu có sức ảnh hưởng toàn cầu, sở hữu nhiều ca khúc nổi tiếng như \u003Ci\u003E\"Haru Haru\", \"FANTASTIC BABY\", \"Last Farewell\" và \"BANG BANG BANG\".\u003C/i\u003E \u003C/p\u003E",
      "avatar": "https://assets.cticket.vn/tix/bigbang2026worldtourinhanoi-tickets/BB_1080x1080.webp",
      "created_at": "2026-07-24T16:21:18.373949+07:00",
      "updated_at": "2026-08-02T20:54:13.55883+07:00"
    }
  ],
  "organizer": {
    "id": "org-019f9352f1167ee4b8e0a90a78603b0f",
    "name": "VPBANK ",
    "email": "chamsockhachhang@vpbank.com.vn",
    "website": "https://www.vpbank.com.vn",
    "logo": "https://assets.cticket.vn/tix/vpbank-marathon/LOGO%20VPBANK%2011.webp",
    "description": "\u003Cp align=\"justify\"\u003E\u003Cstrong\u003ENgân hàng TMCP Việt Nam Thịnh Vượng (VPBank; HoSE: VPB)\u003C/strong\u003E là ngân hàng tư nhân có quy mô lớn nhất Việt Nam, phục vụ hơn 30 triệu khách hàng thông qua hệ sinh thái tài chính toàn diện, gồm ngân hàng, tài chính tiêu dùng, chứng khoán và bảo hiểm.\u003Cbr\u003ETheo đuổi sứ mệnh \u003Ci\u003E\"Vì một Việt Nam Thịnh Vượng\"\u003C/i\u003E, VPBank liên tục mở rộng giá trị dành cho khách hàng từ các giải pháp tài chính hiện đại đến những trải nghiệm văn hóa, thể thao và giải trí đẳng cấp.\u003Cbr\u003ELà nhà tài trợ lớn nhất và đồng tổ chức \u003Cb\u003EBIGBANG 2026-2027 WORLD TOUR ＜ XX : COSMOS ＞ IN HANOI\u003C/b\u003E, VPBank tiếp tục khẳng định vai trò dẫn dắt trong hành trình đưa những sân khấu âm nhạc đỉnh cao thế giới đến với khán giả Việt Nam. Qua đó, ngân hàng góp phần làm phong phú đời sống tinh thần, kết nối cộng đồng người hâm mộ và gia tăng sức hút của Việt Nam trên bản đồ sự kiện quốc tế.\u003Cbr\u003ETìm hiểu thêm tại: \u003Ca href=\"https://www.vpbank.com.vn\"\u003Evpbank.com.vn\u003C/a\u003E\u003C/p\u003E\n\n\u003Cbr\u003E\n\n\u003Cp align=\"justify\"\u003E\u003Cstrong\u003EVietnam Prosperity Joint-Stock Commercial Bank (VPBank; HOSE: VPB)\u003C/strong\u003E is Vietnam's largest private bank by scale, serving more than 30 million customers through a comprehensive financial ecosystem spanning banking, consumer finance, securities and insurance.\u003Cbr\u003EGuided by its mission, \u003Ci\u003E\"For a Prosperous Vietnam\"\u003C/i\u003E, VPBank continues to expand the value it delivers to customers, from modern financial solutions to premium cultural, sporting and entertainment experiences.\u003Cbr\u003EAs the largest sponsor and a co-organiser of \u003Cb\u003EBIGBANG 2026-2027 WORLD TOUR ＜ XX : COSMOS ＞ IN HANOI\u003C/b\u003E, VPBank further reinforces its leading role in bringing the world's most celebrated music stages to Vietnamese audiences. Through these initiatives, the bank helps enrich cultural life, connect fan communities and strengthen Vietnam's appeal on the international events map.\u003Cbr\u003EFind out more: \u003Ca href=\"https://www.vpbank.com.vn\"\u003Evpbank.com.vn\u003C/a\u003E\u003C/p\u003E",
